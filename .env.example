# ─────────────────────────────────────────────
# AI Travel Platform — example env. Commit THIS file (no secrets).
# Copy to .env and fill real values. .env is gitignored.
# ─────────────────────────────────────────────
APP_ENV=development

# ── Host port bindings (deploy) ───────────────────────────────────────────────
# Published to BIND_HOST (default 127.0.0.1 = loopback only); a reverse proxy
# (nginx, installed by hand on the server) fronts them. Containers always listen
# on their internal ports (API 8080, web 3000); these are only the HOST-published
# ports, chosen to not clash with services already on the box. For direct LAN
# access during development (open http://<lan-ip>:WEB_PORT from a phone), set
# BIND_HOST=0.0.0.0.
BIND_HOST=127.0.0.1
API_PORT=8090   # host -> api  (nginx proxies the public /api/ here)
WEB_PORT=3100   # host -> web  (nginx proxies the public site here)
# Postgres/Redis are internal-only by default (not published), so they never
# clash with a Postgres already on the host's 5432. Set POSTGRES_PORT ONLY if you
# want to expose Postgres for inspection (then uncomment its mapping in the
# compose file); leave empty to keep it internal.
POSTGRES_PORT=

# Postgres (local dev Docker). Never point at a shared/prod DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_travel?sslmode=disable

# Redis (local dev Docker)
REDIS_URL=redis://localhost:6379/0

# Auth — change in any non-dev environment
JWT_SECRET=dev-insecure-change-me
JWT_TTL_HOURS=72

# AI. Keys go in .env ONLY (gitignored); never hardcode or commit them.
# Provider: "groq" (default, free) | "gemini" (free) | "claude". Leave the
# chosen provider's key empty to run without AI (endpoints return 503).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Fast, cheap model for simple price extraction (hot path); big model stays for roadmap/chat.
GROQ_FAST_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional: a second Gemini model tried when the primary stays overloaded.
GEMINI_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
AI_BUDGET_USD=100

# Real price scraping (ToS is the operator's responsibility). One source per
# line: "name | tos-note | url-template" with {from} {to} {date} {adults}.
# Empty = no real fetching -> labeled "~ indicative" estimate. The AI extracts
# prices from the fetched page and a verbatim guardrail drops any number not
# present in the text. Blocked/anti-bot pages are skipped (never bypassed).
# JS-rendered pages need the headless build (see README). Example:
#   PRICE_SOURCES="sky | metasearch, ToS restricts scraping | https://www.skyscanner.net/transport/flights/{from}/{to}/{date}/"
PRICE_SOURCES=

# Production hardening. CORS_ORIGINS: comma-separated browser allowlist
# ("*" in dev; set your web origin(s) in prod). Behind nginx the browser calls
# the API same-origin, so CORS is not strictly needed, but set it tight in prod:
#   CORS_ORIGINS=https://travel.myalfasoft.com
# RATE_LIMIT_PER_MIN: per-IP cap on the AI + scrape endpoints.
CORS_ORIGINS=*
RATE_LIMIT_PER_MIN=60

# Web API base resolution (all compile-time; empty keeps the runtime behavior).
#  - NEXT_PUBLIC_API_BASE: production mode selector behind a reverse proxy. Set to
#    "same-origin" so the browser calls /api/v1 on the page's own origin
#    (https://travel.myalfasoft.com/api/v1), which nginx proxies to the API. You
#    may also put a full URL here. EMPTY (default) keeps the D11 LAN fallback:
#    the base is derived from the page host (so a phone on the same Wi-Fi works).
#    For production set: NEXT_PUBLIC_API_BASE=same-origin
#  - NEXT_PUBLIC_API_BASE_URL: pin one fixed, absolute API URL (wins over all).
#  - NEXT_PUBLIC_API_PORT: the port the LAN fallback targets. Keep it equal to
#    API_PORT (the api's host-published port) so LAN derivation hits the API.
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_PORT=8090
# Public site origin for canonical URLs, OpenGraph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Telegram notifications used by local tooling/CI to post run summaries.
# Leave empty to disable — notifications are then skipped silently (no bridge or
# personal account required).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
