# ─────────────────────────────────────────────
# AI Travel Platform — example env. Commit THIS file (no secrets).
# Copy to .env and fill real values. .env is gitignored.
# ─────────────────────────────────────────────
APP_ENV=development
API_PORT=8080

# Postgres (local dev Docker). Never point at a shared/prod DB.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_travel?sslmode=disable

# Redis (local dev Docker)
REDIS_URL=redis://localhost:6379/0

# Auth — change in any non-dev environment
JWT_SECRET=dev-insecure-change-me
JWT_TTL_HOURS=72

# AI. Keys go in .env ONLY (gitignored); never hardcode or commit them.
# Provider: "groq" (default, free) | "gemini" (free) | "claude". Leave the
# chosen provider's key empty to run without AI (endpoints return 503).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Optional: a second Gemini model tried when the primary stays overloaded.
GEMINI_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
AI_BUDGET_USD=100

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
