# Build and run the Next.js web app.
FROM node:22-alpine AS build
WORKDIR /app

# NEXT_PUBLIC_* are compile-time in Next.js, so they must be present during
# `npm run build` to be inlined. Passed as build args from docker-compose (which
# reads them from the root .env). All default to empty => runtime host derivation
# (D11 LAN fallback); set NEXT_PUBLIC_API_BASE=same-origin for a reverse-proxied
# production deploy.
ARG NEXT_PUBLIC_API_BASE=""
ARG NEXT_PUBLIC_API_BASE_URL=""
ARG NEXT_PUBLIC_API_PORT=""
ARG NEXT_PUBLIC_SITE_URL=""
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE \
    NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_API_PORT=$NEXT_PUBLIC_API_PORT \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL

COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
# Surface the baked NEXT_PUBLIC_* in the build log — if a value is empty here, the
# compose build arg didn't reach the build (run from the repo root with
# `--env-file .env`). The app still defaults to same-origin in production.
RUN echo "[web build] NEXT_PUBLIC_API_BASE='$NEXT_PUBLIC_API_BASE' NEXT_PUBLIC_API_BASE_URL='$NEXT_PUBLIC_API_BASE_URL' NEXT_PUBLIC_SITE_URL='$NEXT_PUBLIC_SITE_URL' NEXT_PUBLIC_API_PORT='$NEXT_PUBLIC_API_PORT'"
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3000
CMD ["npm", "run", "start"]
